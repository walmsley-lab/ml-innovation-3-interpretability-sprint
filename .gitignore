# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.hypothesis/

# Experiment outputs — artifacts are content-addressed and live in GCS
artifacts/
outputs/
multirun/
checkpoints/
*.parquet
*.orbax-checkpoint*

# Hidden generator ground truth must never be committed alongside public data
data/hidden_ground_truth/

# Local env / credentials
.env
*.pem
*-key.json

# OS
.DS_Store

# credentials — broadened for a public research repo
.env.*
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
application_default_credentials.json
gha-creds-*.json
*.credentials
.gcloud/

# Run outputs stay ignored, but FREEZE RECORDS are the audit trail and must be
# tracked: hashes and pair lists are what make "frozen before outcomes" checkable
# by anyone other than us.
!artifacts/*.sha256
!artifacts/*frozen*.json
